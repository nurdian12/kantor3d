# URL server WebSocket (gunakan wss:// di produksi)
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Autentikasi (opsional; aktif bila KEDUANYA diisi). AUTH_SECRET harus SAMA di Next.js dan server WebSocket.
# Buat secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
DASHBOARD_PASSWORD=

# Khusus server WebSocket: daftar Origin yang diizinkan (pisahkan koma), mis. http://localhost:3000
WS_ALLOWED_ORIGINS=http://localhost:3000

# Integrasi Repliz (baca-saja, dipanggil dari server; tidak pernah dikirim ke browser).
# Isi SALAH SATU: token bearer, atau pasangan basic auth. Dapatkan kredensial dari dashboard Repliz.
REPLIZ_TOKEN=
# REPLIZ_BASIC_USER=
# REPLIZ_BASIC_PASS=
